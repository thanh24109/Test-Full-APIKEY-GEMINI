# ========================================================
.venv/
venv/
ENV/
env/
env.bak/
venv.bak/

# ========================================================
# 🔐 Secrets & Environment Variables (CRITICAL)
# ========================================================
.env
.env.local
.env.*.local
*.env
# Ensure template is tracked
!.env.example

# Streamlit secrets (config.toml is tracked, secrets.toml is NOT)
.streamlit/secrets.toml

# ========================================================
# 🖥️ Streamlit & Server Caches
# ========================================================
.streamlit/*.log
.streamlit/cache/

